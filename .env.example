# ---------------------------------------------------------------------------
# DROQ environment template. Names only; copy to .env and fill in your own values.
# .env is git-ignored. Never commit real values.
# ---------------------------------------------------------------------------

# --- App (public, read by Expo at build time) -------------------------------
# Your Supabase project URL and its public *anon* key. Never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Dev-only GPS simulation (ignored by production builds) ------------------
EXPO_PUBLIC_TEST_LOCATION_LAT=23.7806
EXPO_PUBLIC_TEST_LOCATION_LNG=90.4070
EXPO_PUBLIC_DEV_SIMULATION=true

# --- Scripts only (scripts/muse-smoke.mjs) -----------------------------------
# Optional local copy of the Meta Model API key for the smoke test. The app never
# reads it. In deployment the key is a server-side Supabase secret (see below).
# MUSE_API_KEY=

# --- Edge function secrets (set with `supabase secrets set NAME=value`, NOT here) ---
# MUSE_API_KEY   Meta Model API key used by supabase/functions/ai-narrator
# MUSE_MODEL     optional, default muse-spark-1.3
# MUSE_BASE_URL  optional, default https://api.meta.ai/v1
# IMAGE_MODEL    optional, default muse-image-1.0
# LLM_API_KEY / LLM_MODEL / LLM_BASE_URL   optional overrides (any OpenAI-compatible API)

# AdMob ad-unit IDs live in the app.json plugin config and constants/ads.ts, not in env.
